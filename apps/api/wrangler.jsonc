{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "komyut-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-18",
  // supabase-js reaches for node built-ins (stream/buffer) in places
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 }
  },
  // Not a secret - a public allowlist of browser origins permitted to call the
  // API. Comma-separated. localhost entries are for `expo start --web`.
  "vars": {
    "CORS_ORIGIN": "https://komyut-web.pages.dev,http://localhost:8081,http://localhost:8082"
  }
  // Secrets are NOT stored here. Set them once with:
  //   npx wrangler secret put SUPABASE_URL
  //   npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY
}
